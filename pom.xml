<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.lxyang01</groupId>
  <artifactId>billguard-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>BillGuard Java Agent Runtime</name>
  <description>可审计账单守卫 Agent Runtime(Java 实现);BillGuard 为业务载体</description>

  <modules>
    <module>agent-runtime</module>
    <module>billguard-domain</module>
    <module>billguard-mcp</module>
    <module>billguard-eval</module>
    <module>billguard-web</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- 版本地板:可用更新补丁版(见 docs/superpowers/plans/2026-09-22-m1-runtime-core.md Global Constraints) -->
    <spring-boot.version>3.5.7</spring-boot.version>
    <junit.version>5.12.2</junit.version>
    <assertj.version>3.27.3</assertj.version>
    <spring-ai.version>1.0.9</spring-ai.version>
    <testcontainers.version>2.0.5</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- spring-ai-bom 先于 Boot 声明以固定 AI 版本(Boot 不管理 spring-ai) -->
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- testcontainers-bom 必须在 spring-boot-dependencies 之前:Boot 3.5 内置
           TC 1.21.3 管理(旧模块名 + 旧传输层,与 Docker 28 npipe 不兼容),
           先声明者胜,故以 2.x 覆盖之 -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.lxyang01</groupId>
        <artifactId>agent-runtime</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.lxyang01</groupId>
        <artifactId>billguard-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.lxyang01</groupId>
        <artifactId>billguard-eval</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <!-- Windows 下确保测试 JVM 与源码一致按 UTF-8 处理中文断言/文案 -->
            <argLine>-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
            <environmentVariables>
              <!-- 国内网络拉 testcontainers/ryuk 常超时;禁用死信容器,容器由 PgTestBase 自行管理。
                   CI(GitHub runner)同样禁用以保持两端行为一致。 -->
              <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
            </environmentVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
